generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model user {
  id String @id @default(uuid())
  firstname String
  lastname String
  username String @unique
  email String
  password String
  isEmailVerified Boolean?
  
  createdAt DateTime @default(now())
  updatedAt DateTime?
}