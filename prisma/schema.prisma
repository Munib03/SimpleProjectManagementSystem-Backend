generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Roles {
  admin
  user
}


model user {
  id String @id @default(uuid())
  firstname String
  lastname String
  email String @unique
  role Roles @default(user)
  password String
  isEmailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime?
}